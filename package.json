{
  "name": "orrery",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "An interactive, physically-grounded 3D orrery of the solar system, with the real sky and guided tours, built with three.js.",
  "scripts": {
    "dev": "node scripts/serve.js",
    "check": "node scripts/check.js",
    "smoke": "node scripts/smoke.js",
    "responsive": "node scripts/responsive.js",
    "vr": "node scripts/vr.js",
    "gamepad": "node scripts/gamepad.js",
    "vendor": "node scripts/vendor.js",
    "desktop:setup": "npm --prefix desktop ci",
    "desktop": "npm --prefix desktop start --",
    "desktop:check": "node desktop/scripts/check.js",
    "desktop:smoke": "npm --prefix desktop run smoke --",
    "desktop:build": "npm --prefix desktop run build --",
    "version": "node desktop/scripts/sync-version.js && git add desktop/package.json desktop/package-lock.json"
  },
  "dependencies": {
    "lil-gui": "^0.20.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.1.1",
    "axe-core": "^4.13.0",
    "iwer": "^2.5.0",
    "puppeteer-core": "^23.11.1"
  }
}
